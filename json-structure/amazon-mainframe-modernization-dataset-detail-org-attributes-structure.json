    "ps": {
      "allOf": [
        {
          "$ref": "#/components/schemas/PsDetailAttributes"
        },
        {
          "description": "The details of a PS type data set."
        }
      ]
    },
    "vsam": {
      "allOf": [
        {
          "$ref": "#/components/schemas/VsamDetailAttributes"
        },
        {
          "description": "The details of a VSAM data set."
