{
  "opencollection": "1.0.0",
  "info": {
    "name": "AWSMainframeModernization Applications Signed Bi Url API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Signed Bi Url",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Amazon Mainframe Modernization Get Signed Bluinsights Url",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://m2.{region}.amazonaws.com/signed-bi-url",
            "headers": [
              {
                "name": "X-Amz-Content-Sha256",
                "value": ""
              },
              {
                "name": "X-Amz-Date",
                "value": ""
              },
              {
                "name": "X-Amz-Algorithm",
                "value": ""
              },
              {
                "name": "X-Amz-Credential",
                "value": ""
              },
              {
                "name": "X-Amz-Security-Token",
                "value": ""
              },
              {
                "name": "X-Amz-Signature",
                "value": ""
              },
              {
                "name": "X-Amz-SignedHeaders",
                "value": ""
              }
            ]
          },
          "docs": "Gets a single sign-on URL that can be used to connect to AWS Blu Insights."
        }
      ]
    }
  ],
  "bundled": true
}